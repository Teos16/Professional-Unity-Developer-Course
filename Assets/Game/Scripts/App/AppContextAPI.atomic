className: AppContextAPI
directory: Assets/Game/Scripts/App/
aggressiveInlining: true
unsafe: false
entityType: IAppContext
namespace: Game.App

imports:
- Game.App
- Atomic.Elements
- Game.Gameplay
- Game.UI

tags:
  # Add your tags here
