namespace: Game.Gameplay
className: GameEntityAPI
directory: Assets/Game/Scripts/Gameplay/GameEntities/
aggressiveInlining: true
unsafe: false
entityType: IGameEntity

imports:
- Atomic.Entities
- UnityEngine
- Atomic.Elements
- Game
- Game.Gameplay

tags:
- Moveable
- Damageable
- Interactible
- Character

values:
- Position: IVariable<Vector3>
- Rotation: IVariable<Quaternion>
- Transform: Transform

# Fire
- FireRequest: IRequest
- FireCondition: IExpression<bool>
- FireAction: ICompositeAction
- FireEvent: IEvent
- FireCooldown: ICooldown

# Movement
- MoveRequest: IRequest<Vector3>
- MoveCondition: IExpression<Vector3, bool>
- MoveAction: ICompositeAction<Vector3, float>
- MoveEvent: IEvent<Vector3>
- MoveSpeed: IValue<float>
- MoveTime: IVariable<float>
- MoveDuration: IValue<float>

# Rotation
- RotateRequest: IRequest<Vector3>
- RotateCondition: IExpression<Vector3, bool>
- RotateAction: ICompositeAction<Vector3, float>
- RotateEvent: IEvent<Vector3>
- RotationSpeed: IValue<float>


# Interact
- InteractCondition: IExpression<IGameEntity, bool>
- InteractAction: ICompositeAction<IGameEntity>
- InteractEvent: IEvent<IGameEntity>
- TargetInteractible: IVariable<IGameEntity>

# Health
- Health: IReactiveVariable<int>
- MaxHealth: IValue<int>

# TakeDamage
- TakeDamageAction: ICompositeAction<int>
- TakeDamageEvent: IEvent<int>
- DeathEvent: IEvent


- Team: IReactiveVariable<TeamType>
- ActivateAction: IAction 
- DeactivateAction: IAction 

- Weapon: IReactiveVariable<IWeaponEntity>
- WeaponPrefab: WeaponEntity

- CurrentTransport: IVariable<IGameEntity>
- ExitPoint: Transform
- Lifetime: ICooldown
- DestroyAction: IAction
- RespawnAction: IAction

- Ammo : IVariable<int>
- Damage: IValue<int>
- Target: IVariable<IGameEntity>
- Trigger: TriggerEvents